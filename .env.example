# Copy to .env and fill in. Referenced by docker-compose.yml.

# GitHub Webhook HMAC secret (required, generate with: openssl rand -hex 32)
WEBHOOK_SECRET=

# GitHub App / PAT token with repo access (required)
GITHUB_TOKEN=

# LLM provider: openai or anthropic (required)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PostgreSQL password used by docker-compose (default: postgres)
POSTGRES_PASSWORD=postgres
