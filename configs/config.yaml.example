# CodeReviewAgent configuration example.
# Copy to configs/config.yaml and adjust. Environment variables
# (SERVER_PORT, WEBHOOK_SECRET, GITHUB_TOKEN, DATABASE_URL, LLM_PROVIDER,
# OPENAI_API_KEY, ANTHROPIC_API_KEY) override these values.

server_port: "8080"
webhook_secret: ""
github_token: ""
database_url: "postgres://localhost:5432/codereviewagent?sslmode=disable"
llm_provider: "openai"
openai_api_key: ""
anthropic_api_key: ""

# Files excluded from review (FR-04).
filter:
  exclude_dirs: ["vendor", "third_party", "node_modules"]
  exclude_patterns:
    - "*_generated.go"
    - "*.pb.go"
    - "*.pb.gw.go"
    - "*.md"
    - "go.sum"
    - "package-lock.json"
    - "yarn.lock"

# Static analysis pipeline running before the review agents (FR-17..FR-24).
static_analysis:
  enabled: true
  workers: 4                    # concurrent analyzer executions
  per_file_timeout_seconds: 30  # per tool, per file
  semgrep_rules_dir: "rules/semgrep"
  golangci_config_path: ""      # optional golangci-lint config override
  tools:
    semgrep:
      enabled: true
    golangci_lint:
      enabled: true
    gitleaks:
      enabled: true
      custom_rules: []          # extra secret rules extending the defaults
      # - id: internal-token
      #   description: Internal service token
      #   pattern: "int_tk_[A-Za-z0-9]{16,}"
      #   keywords: ["int_tk_"]
  # v1.2 adaptive review strategy: deterministic complexity thresholds
  # (FR-34/FR-38). Empty sensitive_paths falls back to built-in defaults
  # (auth, migration, migrations).
  adaptive:
    trivial_max_lines: 20       # < this many changed lines + <= 1 file => Trivial
    complex_min_lines: 200      # > this many changed lines => Complex
    complex_min_files: 5        # > this many files => Complex
    sensitive_paths: []         # e.g. ["internal/auth", "migrations"]

# v1.4 implicit feedback tracking (FR-42).
feedback:
  similarity_threshold: 0.8     # < 0.8 similarity counts as "code modified"

# v1.9 context assembly and memory compression (FR-52..FR-55).
compression:
  trigger_ratio: 0.65           # compress when tokens > 65% of the model window
  absolute_token_limit: 32000   # hard trigger regardless of model window
  keep_recent_rounds: 2         # newest tool-output rounds kept intact
  tool_output_hard_limit: 10000 # per-call tool output cap (characters)
  model_context_window: 128000  # model window used by the ratio trigger
